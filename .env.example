# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# All variables are optional for a local demo: without market-data keys the site
# falls back to yfinance for US prices and skips Alpaca/Finnhub news.

# --- market data (TASK.md §0.7) ---
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
FINNHUB_KEY=
FRED_KEY=
# SEC requires "Name contact@email" (https://www.sec.gov/os/accessing-edgar-data)
SEC_USER_AGENT=

# --- auth (required in production: ENVIRONMENT=prod refuses the dev default) ---
JWT_SECRET=
# ENVIRONMENT=dev

# --- optional LLM trade reviewer (any OpenAI-compatible endpoint, e.g. vLLM) ---
# Used only when all three are set (TRADE_REVIEWER=auto).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# TRADE_REVIEWER=auto          # auto | mock | llm
# PREDICTION_PROVIDER=mock     # mock | mlflow (GPU phase)
# MLFLOW_TRACKING_URI=

# --- infrastructure (docker-compose sets these itself) ---
# DATABASE_URL=postgresql+asyncpg://stock:stock@localhost:5432/stock
# REDIS_URL=redis://localhost:6379/0
# HTTP_PORT=8080
# DATA_UPDATES_ENABLED=true
# LOG_LEVEL=INFO
